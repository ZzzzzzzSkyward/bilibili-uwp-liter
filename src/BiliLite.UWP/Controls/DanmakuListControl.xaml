<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="using:BiliLite.Models.Common" xmlns:fa="using:FontAwesome5" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="BiliLite.Controls.DanmakuListControl" mc:Ignorable="d" d:DesignHeight="48" d:DesignWidth="48">
  <UserControl.Resources>
    <Style x:Key="DanmakuListActionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="IsTabStop" Value="False"/>
    </Style>
  </UserControl.Resources>
  <Button x:Name="BtnOpenDanmakuList" Width="48" Height="48" Padding="0" BorderThickness="0" Background="Transparent" ToolTipService.ToolTip="弹幕列表">
    <fa:FontAwesome Icon="Solid_List" FontSize="20" Foreground="White"/>
    <Button.Flyout>
      <Flyout Placement="Top" Opening="DanmakuListFlyout_Opening">
        <Grid Width="320">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock x:Name="TxtTitle" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button x:Name="BtnReplaceShowMode" HorizontalAlignment="Right" BorderThickness="0" Background="Transparent" Padding="4" ToolTipService.ToolTip="切换范围" Click="BtnReplaceShowMode_Click">
              <fa:FontAwesome Icon="Solid_ExchangeAlt" FontSize="14"/>
            </Button>
          </Grid>
          <ListView x:Name="DanmakuList" Grid.Row="1" MaxHeight="520" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="common:DanmakuListRow">
                <Grid Padding="0 4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind TimeText}" FontSize="12" VerticalAlignment="Center" Margin="0 0 8 0" Opacity="0.7"/>
                  <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource DanmakuListActionButtonStyle}" Tag="{x:Bind}" Click="BtnCopyRow_Click" ToolTipService.ToolTip="复制">
                      <fa:FontAwesome Icon="Solid_Clone" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource DanmakuListActionButtonStyle}" Tag="{x:Bind}" Click="BtnLikeRow_Click" Visibility="{x:Bind ShowLike}" ToolTipService.ToolTip="点赞">
                      <fa:FontAwesome Icon="Solid_ThumbsUp" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource DanmakuListActionButtonStyle}" Tag="{x:Bind}" Click="BtnCancelLikeRow_Click" Visibility="{x:Bind ShowCancelLike}" ToolTipService.ToolTip="取消点赞">
                      <fa:FontAwesome Icon="Solid_ThumbsDown" FontSize="14"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="TxtEmpty" Grid.Row="2" Margin="0 8 0 0" FontSize="12" Opacity="0.7" Text="当前范围内没有已加载的弹幕" Visibility="Collapsed"/>
        </Grid>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
