<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="using:BiliLite.Controls" xmlns:fa="using:FontAwesome5" x:Class="BiliLite.Controls.PlayDirectoryControl" mc:Ignorable="d" RequestedTheme="Dark" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <UserControl.Resources>
    <local:PlayDirectoryVisibleConvert x:Key="pendingVisible"/>
    <local:PlayDirectoryTooltipConvert x:Key="tooltipText"/>
    <Style x:Key="DirectoryTabStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#B3FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12 8"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DirectoryTabActiveStyle" TargetType="Button" BasedOn="{StaticResource DirectoryTabStyle}">
      <Setter Property="Foreground" Value="{ThemeResource HighLightColor}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DirectoryDotStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource HighLightColor}"/>
    </Style>
    <Style x:Key="DirectoryActionStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12 6"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="Root" TabFocusNavigation="Cycle" Background="#F21A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1 0 0 0" PointerPressed="Root_PointerPressed" PointerReleased="Root_PointerReleased" Tapped="Root_Tapped" DoubleTapped="Root_DoubleTapped" AutomationProperties.Name="播放目录">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!--页头只有一个标题:固定的「目录」不再写,抽屉的自动化名称留在 Root 上-->
    <Grid Padding="16 12 8 8" Background="#33000000">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="HeaderText" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
      <Button x:Name="CloseButton" Grid.Column="1" Click="CloseButton_Click" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="关闭播放目录" ToolTipService.ToolTip="关闭目录">
        <TextBlock Text="关闭" FontSize="14" Foreground="White"/>
      </Button>
    </Grid>
    <!--来源名只在页头没带来源时出现(剧集页),位置和数量跟着它-->
    <Grid Grid.Row="1" Padding="16 10 16 4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="SourceTitleText" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
          <TextBlock x:Name="PositionText" FontSize="12" Foreground="#B3FFFFFF"/>
          <TextBlock x:Name="PositionCountText" FontSize="12" Foreground="#B3FFFFFF"/>
        </StackPanel>
      </StackPanel>
      <!--图标表示对准,文字只说目标那一行:同一个意思不说两遍-->
      <Button x:Name="LocateButton" Grid.Column="1" Click="LocateButton_Click" Style="{StaticResource DirectoryActionStyle}" VerticalAlignment="Center" AutomationProperties.Name="定位正在播放" ToolTipService.ToolTip="滚动到正在播放的一行">
        <StackPanel Orientation="Horizontal">
          <fa:FontAwesome Icon="Solid_Crosshairs" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Text="正在播放" FontSize="13" VerticalAlignment="Center" Margin="6 0 0 0"/>
        </StackPanel>
      </Button>
    </Grid>
    <!--在已加载的行里搜索:输入归输入框,上下键进结果列表-->
    <TextBox x:Name="QueryBox" Grid.Row="2" Margin="16 0 16 6" FontSize="14" PlaceholderText="搜索" AutomationProperties.Name="搜索" TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown"/>
    <!--分段页签:只出现有内容的分段;过滤时带命中数,没命中的段留着但点不开-->
    <StackPanel x:Name="TabHost" Grid.Row="3" Orientation="Horizontal" Margin="8 0 8 4"/>
    <!--行:每段共用同一套行模板-->
    <ListView x:Name="RowList" Grid.Row="4" Margin="0 0 0 4" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="RowList_ItemClick" KeyDown="RowList_KeyDown" AutomationProperties.Name="播放目录列表">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Padding" Value="12 6"/>
          <Setter Property="MinHeight" Value="44"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Margin" Value="0 1"/>
          <!--读屏读标题加状态;状态只在自动化名称里,行上的字不复述标题-->
          <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid MinHeight="44">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource HighLightColor}" Visibility="{Binding CurrentBadge, Converter={StaticResource display}}"/>
            <TextBlock Grid.Column="2" Text="{Binding Ordinal}" FontSize="13" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
            <Border Grid.Column="3" Width="64" Height="36" CornerRadius="3" Background="#33FFFFFF">
              <Image Source="{Binding Cover, Converter={StaticResource imageConvert2}, ConverterParameter='200w'}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="4" Margin="8 0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="14" Foreground="White" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title, Converter={StaticResource tooltipText}}"/>
              <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0 2 0 0" ToolTipService.ToolTip="{Binding Subtitle, Converter={StaticResource tooltipText}}"/>
            </StackPanel>
            <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="60">
              <!--等待这一行:只有转圈,没有"正在播放"的条和字-->
              <ProgressRing Width="16" Height="16" IsActive="{Binding IsPending}" Visibility="{Binding IsPending, Converter={StaticResource pendingVisible}}" HorizontalAlignment="Right" Margin="0 0 0 2" Foreground="{ThemeResource HighLightColor}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="{Binding CurrentBadge}" Visibility="{Binding CurrentBadge, Converter={StaticResource display}}" FontSize="11" Foreground="{ThemeResource HighLightColor}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="#99FFFFFF" HorizontalAlignment="Right" Margin="0 2 0 0"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <!--翻页:只属于远程播放列表那一段,按钮长在它的行下面,全屏/全窗口里也点得到-->
    <StackPanel x:Name="PagingHost" Grid.Row="5" Orientation="Horizontal" Padding="16 6 16 10" Visibility="Collapsed">
      <Button x:Name="LoadMoreButton" Click="LoadMoreButton_Click" Style="{StaticResource DirectoryActionStyle}" VerticalAlignment="Center" Margin="0 0 8 0">
        <TextBlock x:Name="LoadMoreText" Text="加载更多" FontSize="13"/>
      </Button>
      <Button x:Name="LoadAllButton" Click="LoadAllButton_Click" Style="{StaticResource DirectoryActionStyle}" VerticalAlignment="Center">
        <TextBlock x:Name="LoadAllText" Text="加载全部" FontSize="13"/>
      </Button>
      <ProgressRing x:Name="PagingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" Margin="4 0 0 0" Foreground="#B3FFFFFF" VerticalAlignment="Center" AutomationProperties.Name="正在加载"/>
    </StackPanel>
    <!--连播来源切换:只在两个外层来源都在时出现,切换不重播-->
    <StackPanel x:Name="SourceActionHost" Grid.Row="6" Orientation="Horizontal" Padding="16 4 16 12" Background="#33000000">
      <Button x:Name="PlayCollectionButton" Click="PlayCollectionButton_Click" Style="{StaticResource DirectoryActionStyle}" Margin="0 0 8 0" AutomationProperties.Name="按合集连播" Visibility="Collapsed">
        <TextBlock Text="按合集连播" FontSize="13"/>
      </Button>
      <Button x:Name="PlayPlaylistButton" Click="PlayPlaylistButton_Click" Style="{StaticResource DirectoryActionStyle}" AutomationProperties.Name="按播放列表连播" Visibility="Collapsed">
        <TextBlock Text="按播放列表连播" FontSize="13"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
