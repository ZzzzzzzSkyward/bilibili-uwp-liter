<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="BiliLite.Controls.PlayDirectoryControl" mc:Ignorable="d" RequestedTheme="Dark" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <UserControl.Resources>
    <Style x:Key="DirectoryTabStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#B3FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12 8"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DirectoryTabActiveStyle" TargetType="Button" BasedOn="{StaticResource DirectoryTabStyle}">
      <Setter Property="Foreground" Value="{ThemeResource HighLightColor}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DirectoryActionStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12 6"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="Root" Background="#F21A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1 0 0 0" PointerPressed="Root_PointerPressed" PointerReleased="Root_PointerReleased" Tapped="Root_Tapped" DoubleTapped="Root_DoubleTapped">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!--标题和关闭-->
    <Grid Padding="16 12 8 8" Background="#33000000">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="目录" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock x:Name="HeaderText" FontSize="12" Foreground="#B3FFFFFF" TextWrapping="Wrap" MaxLines="2" Margin="0 4 0 0"/>
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="1" Click="CloseButton_Click" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="关闭播放目录" ToolTipService.ToolTip="关闭目录">
        <TextBlock Text="关闭" FontSize="14" Foreground="White"/>
      </Button>
    </Grid>
    <!--来源、位置、数量、定位-->
    <Grid Grid.Row="1" Padding="16 10 16 4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="SourceTitleText" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        <TextBlock x:Name="PositionText" FontSize="12" Foreground="#B3FFFFFF" TextWrapping="Wrap" Margin="0 4 0 0"/>
      </StackPanel>
      <Button x:Name="LocateButton" Grid.Column="1" Click="LocateButton_Click" Style="{StaticResource DirectoryActionStyle}" VerticalAlignment="Center" AutomationProperties.Name="定位正在播放" ToolTipService.ToolTip="滚动到正在播放的一行">
        <TextBlock Text="定位正在播放" FontSize="13"/>
      </Button>
    </Grid>
    <!--分段页签:只出现有内容的分段-->
    <StackPanel x:Name="TabHost" Grid.Row="2" Orientation="Horizontal" Margin="8 0 8 4"/>
    <!--行:每段共用同一套行模板-->
    <ListView x:Name="RowList" Grid.Row="3" Margin="0 0 0 4" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="RowList_ItemClick" KeyDown="RowList_KeyDown" AutomationProperties.Name="播放目录列表">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Padding" Value="12 6"/>
          <Setter Property="MinHeight" Value="44"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Margin" Value="0 1"/>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid MinHeight="44">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3"/>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource HighLightColor}" Visibility="{Binding CurrentBadge, Converter={StaticResource display}}"/>
            <TextBlock Grid.Column="1" Text="{Binding Ordinal}" FontSize="13" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Width="64" Height="36" CornerRadius="3" Background="#33FFFFFF">
              <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="3" Margin="8 0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="14" Foreground="White" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0 2 0 0"/>
            </StackPanel>
            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="60">
              <TextBlock Text="{Binding CurrentBadge}" Visibility="{Binding CurrentBadge, Converter={StaticResource display}}" FontSize="11" Foreground="{ThemeResource HighLightColor}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="#99FFFFFF" HorizontalAlignment="Right" Margin="0 2 0 0"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <!--连播来源切换:只在两个外层来源都在时出现,切换不重播-->
    <StackPanel x:Name="SourceActionHost" Grid.Row="4" Orientation="Horizontal" Padding="16 4 16 12" Background="#33000000">
      <Button x:Name="PlayCollectionButton" Click="PlayCollectionButton_Click" Style="{StaticResource DirectoryActionStyle}" Margin="0 0 8 0" AutomationProperties.Name="按合集连播" Visibility="Collapsed">
        <TextBlock Text="按合集连播" FontSize="13"/>
      </Button>
      <Button x:Name="PlayPlaylistButton" Click="PlayPlaylistButton_Click" Style="{StaticResource DirectoryActionStyle}" AutomationProperties.Name="按播放列表连播" Visibility="Collapsed">
        <TextBlock Text="按播放列表连播" FontSize="13"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
