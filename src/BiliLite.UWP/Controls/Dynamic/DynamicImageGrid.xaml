<?xml version='1.0' encoding='UTF-8'?>
<UserControl
    x:Class="BiliLite.Controls.Dynamic.DynamicImageGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BiliLite.Controls.Dynamic"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="480">
  <!--
    静态多图网格(CARD_PLAN §6):瓦片尺寸来自 DynamicImageGridLayout,TileSize 由代码按可用内宽写进每个瓦片模型,
    模板侧只把它绑到根元素上,所以图片没到之前方格已经占好位;间距由 DynamicImageGridPanel 摆放时留出。
  -->
  <ItemsControl x:Name="Tiles" HorizontalAlignment="Left">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <local:DynamicImageGridPanel/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <HyperlinkButton Width="{Binding TileSize}" Height="{Binding TileSize}" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{Binding AccessibilityName}" Command="{Binding Image.ImageCommand}" CommandParameter="{Binding Image}">
          <HyperlinkButton.ContextFlyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="保存" Command="{Binding Image.SaveImageCommand}" CommandParameter="{Binding ImageUrl}">
                <MenuFlyoutItem.Icon>
                  <SymbolIcon Symbol="Save"/>
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </HyperlinkButton.ContextFlyout>
          <Grid>
            <Border CornerRadius="4">
              <controls:ImageEx IsCacheEnabled="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="UniformToFill" PlaceholderSource="ms-appx:///Assets/Thumbnails/Placeholde1x1.png" Source="{Binding ThumbUrl}"/>
            </Border>
            <!-- 第九张上的 +N:只标被收起的张数,点开仍是完整原图列表,索引指向这张自己 -->
            <Border Visibility="{Binding OverflowVisibility}" Background="#66000000" CornerRadius="4">
              <TextBlock Text="{Binding OverflowText}" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </HyperlinkButton>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
