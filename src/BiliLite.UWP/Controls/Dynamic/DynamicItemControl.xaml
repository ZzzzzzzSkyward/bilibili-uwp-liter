<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:BiliLite.Controls.Dynamic" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="using:BiliLite.Controls.Dynamic" xmlns:fa="using:FontAwesome5" xmlns:converters="using:BiliLite.Converters" x:Class="BiliLite.Controls.Dynamic.DynamicItemControl" mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="400">
  <!--
    动态卡片排版令牌 —— 来源 CARD_PLAN.md §5(CARD_PLAN §5「Layout and typography tokens」「Responsive behavior」)。
    所有数字都是 UWP 有效像素的起始值,设备联调时按这张表改;窄态(<480)的值由
    DynamicItemControl.xaml.cs 的 ApplyWidthState 统一写出,宽态值就是下面各处的字面量。

      令牌                 宽态       窄态(<480)   落点
      阅读列宽             800 最大   —            CardRoot.MaxWidth(本文件);正文不再各自假设 800
      页面留白             12        8            CardRoot.Margin 左右
      卡片间距             4         4            CardRoot.Margin 下 4 + ListViewItem 上下 2(相邻两卡内容之间 8+4+2+2+8=24,原为 48)
      卡片内边距           16,8      12,8         CardSurface.Padding(左右 16/12,上下 8)
      卡片圆角             8         —            CardSurface.CornerRadius(无边框,卡片间只靠 CardRoot.Margin 下 4)
      正文                 16 常规    同左          RichTextControl.xaml.cs(BodyFontSize,富文本与纯文本回退同一处)
      正文行高             24 最小    同左          RichTextControl.xaml.cs(BodyLineHeight + MaxHeight 行距策略)
      作者名               15 半粗    同左          HeaderName 两个 TextBlock(单行 + 省略号)
      发表时间             12 常规    同左          HeaderTime
      卡片标题槽           18 半粗/26 同左          CardTitle(头部下方、正文上方,最多两行;空标题整行不占位)
      预告/OPUS 标题       18 半粗/26 同左          DynamicTemplate.xaml OneRow/Reserve 的标题
      预告描述             14/21      同左          DynamicTemplate.xaml OneRow Subtitle、Reserve Desc
      互动计数/小徽标      13 / 12   同左          ActionRow 内 TextBlock / 作者 TAG 徽标
      头部头像             40×40      同左          HeaderAvatar(转发原作者行仍为 24×24)
      区块间距/细间距      8 / 4      8 / 4        HeaderArea 与 BodyPresenter/CardContentPresenter/ActionRow 之间 8;名字与时间之间 4
      互动点击区           ≥40×40     同左          ActionRow 各按钮 MinWidth/MinHeight 与头部按钮;
                                                 图标 16(互动栏)/ 14(头部 AppBarButton 自带)
      响应式断点           480        —            DynamicItemControl.xaml.cs NarrowWidthThreshold

    未按计划取值的两处,原因记录在此,不改动数据契约:
      · 卡片表面没有可用的不透明主题色(App.xaml 的 CardColor/TopPaneBackground 都是全透明),故不加背景也不加边框,卡片之间只靠 CardRoot.Margin 的下 4(加 ListViewItem 上下 2 与卡片上下内边距 8)留白分隔。
      · 图片九宫格仍是固定 100/120 像素瓦片(模板内无法按卡片宽度算列宽,需代码或新文件),不在本次改动内。
  -->
  <UserControl.Resources>
    <converters:CountOrTextConvert x:Name="countConvert"/>
    <converters:ColorConvert x:Name="colorConvert"/>
    <Style TargetType="HyperlinkButton">
      <Setter Property="Foreground" Value="#178bcf"/>
    </Style>
  </UserControl.Resources>
  <!-- 阅读列:最大 800,宽窗口居中,窄窗口自 stretch 到可用宽度 -->
  <Grid x:Name="CardRoot" Margin="12,0,12,4" MaxWidth="800" HorizontalAlignment="Stretch" VerticalAlignment="Top">
    <Border x:Name="CardSurface" CornerRadius="8" Padding="16,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--头部行:头像 | 昵称/时间 | 可选装扮 | 操作。正文与媒体从下一行起占满整宽-->
        <Grid x:Name="HeaderArea" Grid.Row="0">
          <Grid Visibility="{x:Bind Path=Model.AuthorHeaderVisibility,Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <HyperlinkButton x:Name="HeaderAvatar" Grid.Column="0" Margin="0,0,12,0" Padding="0" VerticalAlignment="Top" Command="{x:Bind Path=Model.UserCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model.Mid,Mode=OneWay}">
              <!-- 头像格固定 40,装扮挂件只是叠在上面的装饰,不再单独占一列挤压正文 -->
              <Grid Width="40" Height="40">
                <Ellipse Width="40" Height="40" Stroke="WhiteSmoke" StrokeThickness="1">
                  <Ellipse.Fill>
                    <ImageBrush ImageSource="{x:Bind Path=Model.Photo,Mode=OneWay,Converter={StaticResource imageConvert2},ConverterParameter='64h'}"/>
                  </Ellipse.Fill>
                </Ellipse>
                <Image Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Source="{x:Bind Path=Model.Pendant,Mode=OneWay}"/>
                <Image Width="16" Height="16" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,4" Source="{x:Bind Path=Model.Verify,Mode=OneWay}"/>
              </Grid>
            </HyperlinkButton>
            <!-- 昵称列:星号宽度 + 单行省略号,完整昵称在 ToolTip -->
            <HyperlinkButton Grid.Column="1" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{x:Bind Path=Model.UserCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model.Mid,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Path=Model.UserName,Mode=OneWay}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Visibility="{x:Bind Path=Model.ShowTag,Mode=OneWay}" Margin="0,0,4,0" VerticalAlignment="Center" Background="HotPink" CornerRadius="2">
                    <TextBlock Foreground="White" FontSize="12" Margin="4,2" Text="{x:Bind Path=Model.TagName,Mode=OneWay}"/>
                  </Border>
                  <Grid Grid.Column="1">
                    <TextBlock x:Name="HeaderName" Text="{x:Bind Path=Model.UserName,Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource HighLightTextColor}" Opacity=".8" Visibility="{x:Bind Path=Model.IsYearVip,Mode=OneWay}"/>
                    <TextBlock x:Name="HeaderNamePlain" Text="{x:Bind Path=Model.UserName,Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextColor}" Visibility="{x:Bind Path=Model.IsYearVip,Mode=OneWay,Converter={StaticResource display}}"/>
                  </Grid>
                </Grid>
                <TextBlock x:Name="HeaderTime" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ForegroundTextColor}" ToolTipService.ToolTip="{x:Bind Path=Model.Datetime,Mode=OneWay}" Text="{x:Bind Path=Model.Time,Mode=OneWay}"/>
              </StackPanel>
            </HyperlinkButton>
            <!-- 装扮:窄态整格收起,信息移到头部溢出菜单 -->
            <Grid x:Name="DecorationSlot" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
              <Grid HorizontalAlignment="Right" ToolTipService.ToolTip="{x:Bind Path=Model.DecorateName,Mode=OneWay}" Visibility="{x:Bind Path=Model.ShowDecorate,Mode=OneWay}">
                <Image Height="44" Source="{x:Bind Path=Model.DecorateImage,Mode=OneWay,Converter={StaticResource imageConvert2},ConverterParameter='64h.png'}"/>
                <TextBlock FontSize="12" Visibility="{x:Bind Path=Model.ShowDecorateText,Mode=OneWay}" FontFamily="{StaticResource FansNum}" VerticalAlignment="Center" Margin="0,0,40,0" HorizontalAlignment="Right" Foreground="{x:Bind Path=Model.DecorateColor,Mode=OneWay,Converter={StaticResource colorConvert}}" Text="{x:Bind Path=Model.DecorateText,Mode=OneWay}"/>
              </Grid>
            </Grid>
            <!-- 宽态:详情/网页/删除各自独立一格,不再和昵称挤在同一个横向 StackPanel -->
            <StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.5">
              <AppBarButton Icon="OpenFile" ToolTipService.ToolTip="打开详情" Command="{x:Bind Path=Model.DetailCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}" MinWidth="40" MinHeight="40"/>
              <AppBarButton Icon="Globe" ToolTipService.ToolTip="网页打开" Command="{x:Bind Path=Model.WebCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model.DynamicUrl,Mode=OneWay}" MinWidth="40" MinHeight="40"/>
              <AppBarButton Icon="Flag" ToolTipService.ToolTip="举报" Visibility="Collapsed" MinWidth="40" MinHeight="40"/>
              <AppBarButton Icon="Delete" ToolTipService.ToolTip="删除" Command="{x:Bind Path=Model.DeleteCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}" Visibility="{x:Bind Path=Model.IsSelf,Mode=OneWay}" MinWidth="40" MinHeight="40"/>
            </StackPanel>
            <!-- 窄态:一个溢出入口,同样的命令,不再挤压昵称 -->
            <Button x:Name="HeaderOverflow" Grid.Column="3" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="40" MinHeight="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="更多操作">
              <SymbolIcon Symbol="More"/>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="打开详情" Command="{x:Bind Path=Model.DetailCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="OpenFile"/>
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="网页打开" Command="{x:Bind Path=Model.WebCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model.DynamicUrl,Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Globe"/>
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="删除" Command="{x:Bind Path=Model.DeleteCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}" Visibility="{x:Bind Path=Model.IsSelf,Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Delete"/>
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator Visibility="{x:Bind Path=Model.ShowDecorate,Mode=OneWay}"/>
                  <MenuFlyoutItem Text="{x:Bind Path=Model.DecorateName,Mode=OneWay}" IsEnabled="False" Visibility="{x:Bind Path=Model.ShowDecorate,Mode=OneWay}"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <!--转发作者的头部:头像/昵称与“打开详情”是并列的两个控件,不再嵌套按钮-->
          <Grid Visibility="{x:Bind Path=Model.RepostAuthorVisibility,Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <HyperlinkButton Grid.Column="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind Path=Model.UserCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model.Mid,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Path=Model.UserName,Mode=OneWay}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0">
                  <Ellipse.Fill>
                    <ImageBrush ImageSource="{x:Bind Path=Model.Photo,Mode=OneWay,Converter={StaticResource imageConvert2},ConverterParameter='64w'}"/>
                  </Ellipse.Fill>
                </Ellipse>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="#178bcf">
                  <Run Text="{x:Bind Path=Model.UserName,Mode=OneWay}"/>
                  <Run Text="{x:Bind Path=Model.Tooltip,Mode=OneWay}" Foreground="{ThemeResource ForegroundTextColor}" FontSize="12"/>
                </TextBlock>
              </Grid>
            </HyperlinkButton>
            <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="40" MinHeight="40" Padding="0" Background="Transparent" BorderThickness="0" Command="{x:Bind Path=Model.DetailCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}" Foreground="{ThemeResource ForegroundTextColor}" AutomationProperties.Name="打开详情">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE17C;"/>
            </Button>
          </Grid>
        </Grid>
        <!--标题槽(CARD_PLAN §5 渲染顺序 header → title → body):空标题时整行 Collapsed,不占位也不留 8px-->
        <TextBlock x:Name="CardTitle" Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Stretch" Text="{x:Bind Path=Model.Title,Mode=OneWay}" Visibility="{x:Bind Path=Model.TitleVisibility,Mode=OneWay}" FontSize="18" FontWeight="SemiBold" LineHeight="26" LineStackingStrategy="MaxHeight" Foreground="{ThemeResource TextColor}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
        <!--正文:模板自己渲染正文时(ContentPresenterVisibility=Collapsed)这里的 12px 间距不占位-->
        <ContentPresenter x:Name="BodyPresenter" Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Stretch" Visibility="{x:Bind Path=Model.ContentPresenterVisibility,Mode=OneWay}" Content="{x:Bind Path=Model.PresenterContent,Mode=OneWay}"/>
        <!--媒体/预告/附件/转发原动态:占满整宽-->
        <ContentPresenter x:Name="CardContentPresenter" Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="{x:Bind Path=CardContent,Mode=OneWay}"/>
        <!--互动栏:三等分列,按钮点击区 ≥40×40-->
        <Grid x:Name="ActionRow" Grid.Row="4" Margin="0,8,0,0" Visibility="{x:Bind Path=Model.InteractionRowVisibility,Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <HyperlinkButton MinWidth="40" MinHeight="40" Padding="0" Command="{x:Bind Path=Model.RepostCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}" Foreground="{ThemeResource ForegroundTextColor}" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <fa:FontAwesome Icon="Solid_Share" Margin="0,2,0,0" FontSize="16"/>
                <TextBlock Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" Text="{x:Bind Path=Model.ShareCount,Mode=OneWay,Converter={StaticResource countConvert},ConverterParameter='转发'}"/>
              </StackPanel>
            </HyperlinkButton>
          </Grid>
          <Grid Grid.Column="1">
            <HyperlinkButton MinWidth="40" MinHeight="40" Padding="0" Command="{x:Bind Path=Model.CommentCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}" Foreground="{ThemeResource ForegroundTextColor}" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <fa:FontAwesome Icon="Regular_Comment" Margin="0,2,0,0" FontSize="16"/>
                <TextBlock Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" Text="{x:Bind Path=Model.CommentCount,Mode=OneWay,Converter={StaticResource countConvert},ConverterParameter='评论'}"/>
              </StackPanel>
            </HyperlinkButton>
          </Grid>
          <Grid Grid.Column="2">
            <HyperlinkButton MinWidth="40" MinHeight="40" Padding="0" Visibility="{x:Bind Path=Model.Liked,Mode=OneWay,Converter={StaticResource display}}" Command="{x:Bind Path=Model.LikeCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}" Foreground="{ThemeResource ForegroundTextColor}" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <fa:FontAwesome Icon="Regular_ThumbsUp" Margin="0,2,0,0" FontSize="16"/>
                <TextBlock Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" Text="{x:Bind Path=Model.LikeCount,Mode=OneWay,Converter={StaticResource countConvert},ConverterParameter='点赞'}"/>
              </StackPanel>
            </HyperlinkButton>
            <HyperlinkButton MinWidth="40" MinHeight="40" Padding="0" Visibility="{x:Bind Path=Model.Liked,Mode=OneWay}" Command="{x:Bind Path=Model.LikeCommand,Mode=OneWay}" CommandParameter="{x:Bind Path=Model,Mode=OneWay}" Foreground="{ThemeResource HighLightColor}" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <fa:FontAwesome Icon="Regular_ThumbsUp" Margin="0,2,0,0" FontSize="16"/>
                <TextBlock Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" Text="{x:Bind Path=Model.LikeCount,Mode=OneWay,Converter={StaticResource countConvert},ConverterParameter='点赞'}"/>
              </StackPanel>
            </HyperlinkButton>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
