<?xml version='1.0' encoding='UTF-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="using:FontAwesome5" xmlns:converters="using:BiliLite.Converters" xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls" xmlns:local="using:BiliLite.Controls.Dynamic">
  <local:DynamicItemDataTemplateSelector x:Key="select" TextTemplate="{StaticResource Text}" MissTemplate="{StaticResource Miss}" RepostTemplate="{StaticResource Repost}" Photo1x1Template="{StaticResource Photo1x1}" PhotoGridTemplate="{StaticResource PhotoGrid}" ShortVideoTemplate="{StaticResource ShortVideo}" OneRowTemplate="{StaticResource OneRow}" ReserveTemplate="{StaticResource Reserve}" OtherTemplate="{StaticResource Other}">
    </local:DynamicItemDataTemplateSelector>
  <DataTemplate x:Key="Reserve">
    <local:DynamicItemControl Model="{Binding}">
      <local:DynamicItemControl.CardContent>
        <StackPanel>
          <local:RichTextControl Text="{Binding Path=OneRowInfo.Subtitle}" Content="{Binding Path=Content}"/>
          <Border BorderThickness="1" HorizontalAlignment="Stretch" BorderBrush="{ThemeResource ForegroundTextColor}" CornerRadius="4">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="4 4 4 4">
              <TextBlock Margin="0 0 0 0" Text="{Binding Path=OneRowInfo.Title}" FontSize="18" FontWeight="SemiBold" LineHeight="26" LineStackingStrategy="MaxHeight" Foreground="{ThemeResource TextColor}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
              <TextBlock Margin="0 8 0 0" Text="{Binding Path=OneRowInfo.Desc}" FontSize="14" LineHeight="21" LineStackingStrategy="MaxHeight" Foreground="{ThemeResource ForegroundTextColor}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
            </StackPanel>
            <!--HyperlinkButton Command="{Binding Path=LaunchUrlCommand}" CommandParameter="{Binding Path=OneRowInfo.Url}" Background="#dd00a9" CornerRadius="2" HorizontalAlignment="Right" Margin="0 0 8 0" Height="40">
                            //实际上根本没有办法点击这个按钮
                                <TextBlock FontSize="14" Text="{Binding Path=OneRowInfo.CoverText}" Foreground="{ThemeResource ForegroundTextColor}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"></TextBlock>
                            </HyperlinkButton-->
          </Border>
        </StackPanel>
      </local:DynamicItemControl.CardContent>
    </local:DynamicItemControl>
  </DataTemplate>
  <DataTemplate x:Key="OneRow">
    <local:DynamicItemControl Model="{Binding}">
      <local:DynamicItemControl.CardContent>
        <Border BorderThickness="1" HorizontalAlignment="Stretch" BorderBrush="{ThemeResource ForegroundTextColor}" CornerRadius="4">
          <HyperlinkButton Padding="0" Margin="0" Command="{Binding Path=LaunchUrlCommand}" CommandParameter="{Binding Path=OneRowInfo.Url}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <HyperlinkButton.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem Visibility="{Binding Path=ShowWatchLater}" Icon="Add" Text="添加到稍后再看" Command="{Binding Path=WatchLaterCommand}" CommandParameter="{Binding Path=OneRowInfo.ID}"/>
              </MenuFlyout>
            </HyperlinkButton.ContextFlyout>
            <Grid HorizontalAlignment="Stretch">
              <!--
                预告/媒体槽位(DynamicItemControl.xaml 令牌表的“预告/OPUS 标题”“预告描述”):
                媒体列按星号分配并封顶 160,标题列拿 2/3。卡片变窄时媒体连续缩小(320 视口的卡片内宽下约 96),
                宽窗口下停在 160×90;不再用固定 CoverWidth 写死,也不给正文列留 800 的宽度假设。
                框的比例与尺寸由 DynamicPreviewRow 负责(16:9 先占位,加载中/失败都不塌),模板只剩上限。
              -->
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="160"/>
                <ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>
              <local:DynamicPreviewRow Source="{Binding Path=OneRowInfo.Cover}" ForceSixteenByNine="True" MaxFrameWidth="160" CompactFrameWidth="96" MinFrameWidth="88">
                <local:DynamicPreviewRow.OverlayContent>
                  <Grid IsHitTestVisible="False">
                    <Border Visibility="{Binding Path=OneRowInfo.ShowTag}" Background="#C8FF69B4" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                      <TextBlock Margin="4 2" Foreground="White" FontSize="12" Text="{Binding Path=OneRowInfo.Tag}"/>
                    </Border>
                    <Border Visibility="{Binding Path=OneRowInfo.ShowCoverText}" Background="#C8000000" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4">
                      <TextBlock Margin="4 2" Foreground="White" FontSize="12" Text="{Binding Path=OneRowInfo.CoverText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                    </Border>
                  </Grid>
                </local:DynamicPreviewRow.OverlayContent>
              </local:DynamicPreviewRow>
              <StackPanel HorizontalAlignment="Stretch" Grid.Column="1" Margin="12 0 0 0">
                <TextBlock FontSize="18" FontWeight="SemiBold" LineHeight="26" LineStackingStrategy="MaxHeight" Text="{Binding Path=OneRowInfo.Title}" Foreground="{ThemeResource TextColor}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                <TextBlock Visibility="Collapsed" Text="{Binding Path=OneRowInfo.Desc}" Margin="0 4 0 0" FontSize="14" LineHeight="21" LineStackingStrategy="MaxHeight" Foreground="{ThemeResource ForegroundTextColor}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                <TextBlock Margin="0 4 0 0" Text="{Binding Path=OneRowInfo.Subtitle}" FontSize="14" LineHeight="21" LineStackingStrategy="MaxHeight" Foreground="{ThemeResource ForegroundTextColor}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </HyperlinkButton>
        </Border>
      </local:DynamicItemControl.CardContent>
    </local:DynamicItemControl>
  </DataTemplate>
  <DataTemplate x:Key="ShortVideo">
    <local:DynamicItemControl Model="{Binding}">
      <local:DynamicItemControl.CardContent>
        <Grid>
          <MediaElement AreTransportControlsEnabled="True" AutoPlay="False" MaxHeight="320" Source="{Binding Path=ShortVideoInfo.VideoPlayurl}">
                    </MediaElement>
        </Grid>
      </local:DynamicItemControl.CardContent>
    </local:DynamicItemControl>
  </DataTemplate>
  <DataTemplate x:Key="Text">
    <local:DynamicItemControl Model="{Binding}">
      <local:DynamicItemControl.CardContent>
        <local:RichTextControl Content="{Binding Content}" Text="{Binding OneRowInfo.Desc}"/>
      </local:DynamicItemControl.CardContent>
    </local:DynamicItemControl>
  </DataTemplate>
  <DataTemplate x:Key="Photo1x1">
    <local:DynamicItemControl Model="{Binding}">
      <local:DynamicItemControl.CardContent>
        <StackPanel Orientation="Vertical">
          <local:RichTextControl Content="{Binding Path=Content}" Text="{Binding Path=OneRowInfo.Desc}"/>
          <!--
            单图:先按 ImagesInfo[0] 的宽高占比例框(MaxWidth 400 / MaxHeight 500 仍是上限,超高时按比例反推宽度),
            宽高缺失时退回中性比例;LongImage 角标放在框的角标层上,尺寸缺失时数据侧本来就不算长图。
          -->
          <local:DynamicPreviewRow HorizontalAlignment="Stretch" MaxFrameWidth="400" MaxFrameHeight="500" MinFrameWidth="0" Source="{Binding Path=ImagesInfo[0].ImageUrlWithPar}" NaturalWidth="{Binding Path=ImagesInfo[0].Width}" NaturalHeight="{Binding Path=ImagesInfo[0].Height}">
            <local:DynamicPreviewRow.OverlayContent>
              <Grid>
                <HyperlinkButton Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Command="{Binding Path=ImageCommand}" CommandParameter="{Binding Path=ImagesInfo[0]}">
                  <HyperlinkButton.ContextFlyout>
                    <MenuFlyout>
                      <MenuFlyoutItem Text="保存" Command="{Binding Path=SaveImageCommand}" CommandParameter="{Binding Path=ImagesInfo[0].ImageUrl}">
                        <MenuFlyoutItem.Icon>
                          <SymbolIcon Symbol="Save"/>
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </HyperlinkButton.ContextFlyout>
                </HyperlinkButton>
                <Border Visibility="{Binding Path=ImagesInfo[0].LongImage}" CornerRadius="2" Margin="8" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#66000000">
                  <TextBlock Margin="4" FontSize="12" Foreground="White">长图</TextBlock>
                </Border>
              </Grid>
            </local:DynamicPreviewRow.OverlayContent>
          </local:DynamicPreviewRow>
        </StackPanel>
      </local:DynamicItemControl.CardContent>
    </local:DynamicItemControl>
  </DataTemplate>
  <DataTemplate x:Key="PhotoGrid">
    <local:DynamicItemControl Model="{Binding}">
      <local:DynamicItemControl.CardContent>
        <StackPanel Orientation="Vertical">
          <local:RichTextControl Text="{Binding Path=OneRowInfo.Desc}" Content="{Binding Path=Content}"/>
          <!--
            2 张以上统一走这一份网格(CARD_PLAN §6):2 张一行两列、4 张 2×2、3/5-9 张按 88 阈值决定三列还是两列、
            超过 9 张第九张带 +N。列宽/元素/间距全在 DynamicImageGridLayout,模板只给图片列表,
            所以 4 张也拿到了与其它张数相同的保存菜单。
          -->
          <local:DynamicImageGrid ItemsSource="{Binding Path=ImagesInfo}"/>
        </StackPanel>
      </local:DynamicItemControl.CardContent>
    </local:DynamicItemControl>
  </DataTemplate>
  <DataTemplate x:Key="Miss">
    <Border BorderThickness="1" HorizontalAlignment="Stretch" BorderBrush="{ThemeResource ForegroundBorderColor}" CornerRadius="4">
      <StackPanel Orientation="Horizontal" Margin="12">
        <FontIcon Foreground="{ThemeResource ForegroundTextColor}" FontSize="14" FontFamily="Segoe MDL2 Assets" Glyph=""/>
        <TextBlock Foreground="{ThemeResource ForegroundTextColor}" Margin="8 0 0 0">资源已失效</TextBlock>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="Other">
    <Border BorderThickness="1" HorizontalAlignment="Stretch" BorderBrush="{ThemeResource ForegroundBorderColor}" CornerRadius="4">
      <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap">无法显示此动态,有待修复</TextBlock>
        <TextBlock Margin="0 0 8 0" Text="{Binding Path=ContentStr}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="Repost">
    <local:DynamicItemControl Model="{Binding}">
      <local:DynamicItemControl.CardContent>
        <StackPanel HorizontalAlignment="Stretch">
          <local:RichTextControl Text="{Binding Path=OneRowInfo.Subtitle}" Content="{Binding Path=Content}"/>
          <Border BorderThickness="1" BorderBrush="{ThemeResource ForegroundBorderColor}" CornerRadius="4" Background="{ThemeResource TopPaneBackground}" Visibility="{Binding Path=OriginVisibility}">
            <ListView SelectionMode="None" IsItemClickEnabled="false" ItemsSource="{Binding Path=OriginInfo}" ItemTemplateSelector="{StaticResource select}" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="Padding" Value="0"/>
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
          </Border>
          <!--
            转发深度上限(CARD_PLAN §3.7/§7):数据侧只保留一层 OriginInfo,更深的祖先压缩成这一行跳转,
            外面不再套一层递归模板;Visibility 由数据侧给,深度没被截断时整行不占位。
          -->
          <HyperlinkButton Content="查看原动态" Visibility="{Binding Path=AncestryVisibility}" Command="{Binding Path=DetailByIdCommand}" CommandParameter="{Binding Path=AncestryDynamicID}" MinWidth="40" MinHeight="40" Padding="0" Margin="0,8,0,0" Foreground="#178bcf"/>
        </StackPanel>
      </local:DynamicItemControl.CardContent>
    </local:DynamicItemControl>
  </DataTemplate>
</ResourceDictionary>
