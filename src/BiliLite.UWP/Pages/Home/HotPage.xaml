<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:BiliLite.Pages.Home" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:modules="using:BiliLite.Modules" xmlns:controls="using:BiliLite.Controls" xmlns:covert="using:BiliLite.Converters" xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls" xmlns:winui="using:Microsoft.UI.Xaml.Controls" x:Class="BiliLite.Pages.Home.HotPage" mc:Ignorable="d" Background="{ThemeResource TransparentBackground}">
  <Page.Resources>
    <covert:ColorConvert x:Key="colorConvert"/>
    <covert:DisplayConvert x:Key="DisplayConvert"/>
    <!--
      卡片预算（有效像素，100% 文字大小），一律由 ItemHeight 推导，不靠 MinHeight 兜底：
      槽位内缩只有 GridViewItem 的 Margin=4 一处，模板根节点 Margin/Padding 均为 0，
      所以内容高 = ItemHeight − 2×4。
      宽卡：内容高 = 106 − 8 = 98；
            文本列高 = 标题两行 54（20px SemiBold，行高 ≈ 27×2）+ 间距 2 + 元信息 18 + 间距 2 + 元信息 18 = 94，余量 4；
            文本列宽 = 560 − 2×4 − 160（封面列）− 12（列间距）= 380；
            封面 160×90，推荐标签 MaxWidth = 封面宽 160 − 2×4 = 152，一行省略号截断，不参与文本列高度竞争；
            封面与文字各自内缩 4px（标签与右下角胶囊各 Margin=4），不贴槽位边缘。
      竖排卡（窗口 < 480）：内容高 = 278 − 8 = 270 = 封面 160 + 间距 12 + 文本 98（与宽卡文本列同高）；
            文本列宽 = 320 − 2×4 = 312。
    -->
    <DataTemplate x:Key="hotVideoCardWide" x:DataType="modules:HotDataItemModel">
      <Grid Background="#00FFFFFF" Margin="0">
        <Grid.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem Click="AddToWatchLater_Click" Icon="Add" Text="添加到稍后再看"/>
          </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Height="90" VerticalAlignment="Center" CornerRadius="{StaticResource ImageCornerRadius}">
          <Grid>
            <toolkit:ImageEx IsCacheEnabled="True" PlaceholderSource="ms-appx:///Assets/Thumbnails/Placeholde.png" Stretch="UniformToFill" Source="{x:Bind Path=cover,Converter={StaticResource imageConvert},ConverterParameter='120h'}"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="152" Margin="4" Padding="6 2" CornerRadius="2" BorderThickness="1" BorderBrush="{x:Bind Path=rcmd_reason_style.border_color,Converter={StaticResource colorConvert}}" Background="{x:Bind Path=rcmd_reason_style.bg_color,Converter={StaticResource colorConvert}}" Visibility="{x:Bind Path=rcmd_reason_style.text,Mode=OneWay,Converter={StaticResource DisplayConvert}}">
              <TextBlock FontSize="11" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{x:Bind Path=rcmd_reason_style.text_color,Converter={StaticResource colorConvert}}" Text="{x:Bind Path=rcmd_reason_style.text}"/>
            </Border>
            <Border CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="4" Padding="4 2" Background="#99000000" Visibility="{x:Bind cover_right_text_1,Mode=OneWay,Converter={StaticResource DisplayConvert}}">
              <TextBlock Foreground="White" FontSize="12" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind cover_right_text_1}"/>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Column="2" VerticalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Margin="0 0 0 2" FontSize="20" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{x:Bind title}" ToolTipService.ToolTip="{x:Bind title}"/>
          <TextBlock Grid.Row="1" Margin="0 0 0 2" FontSize="13" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ForegroundTextColor}" Text="{x:Bind right_desc_1}"/>
          <TextBlock Grid.Row="2" FontSize="13" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ForegroundTextColor}" Text="{x:Bind right_desc_2}"/>
        </Grid>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="hotVideoCardStacked" x:DataType="modules:HotDataItemModel">
      <Grid Background="#00FFFFFF" Margin="0">
        <Grid.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem Click="AddToWatchLater_Click" Icon="Add" Text="添加到稍后再看"/>
          </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.RowDefinitions>
          <RowDefinition Height="160"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border CornerRadius="{StaticResource ImageCornerRadius}">
          <Grid>
            <toolkit:ImageEx IsCacheEnabled="True" PlaceholderSource="ms-appx:///Assets/Thumbnails/Placeholde.png" Stretch="UniformToFill" Source="{x:Bind Path=cover,Converter={StaticResource imageConvert},ConverterParameter='120h'}"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="152" Margin="4" Padding="6 2" CornerRadius="2" BorderThickness="1" BorderBrush="{x:Bind Path=rcmd_reason_style.border_color,Converter={StaticResource colorConvert}}" Background="{x:Bind Path=rcmd_reason_style.bg_color,Converter={StaticResource colorConvert}}" Visibility="{x:Bind Path=rcmd_reason_style.text,Mode=OneWay,Converter={StaticResource DisplayConvert}}">
              <TextBlock FontSize="11" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{x:Bind Path=rcmd_reason_style.text_color,Converter={StaticResource colorConvert}}" Text="{x:Bind Path=rcmd_reason_style.text}"/>
            </Border>
            <Border CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="4" Padding="4 2" Background="#99000000" Visibility="{x:Bind cover_right_text_1,Mode=OneWay,Converter={StaticResource DisplayConvert}}">
              <TextBlock Foreground="White" FontSize="12" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind cover_right_text_1}"/>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Row="2" VerticalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Margin="0 0 0 2" FontSize="20" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{x:Bind title}" ToolTipService.ToolTip="{x:Bind title}"/>
          <TextBlock Grid.Row="1" Margin="0 0 0 2" FontSize="13" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ForegroundTextColor}" Text="{x:Bind right_desc_1}"/>
          <TextBlock Grid.Row="2" FontSize="13" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ForegroundTextColor}" Text="{x:Bind right_desc_2}"/>
        </Grid>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="HotCardLayoutStates">
        <VisualState x:Name="WideCard">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="480"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="gridHot.ItemHeight" Value="106"/>
            <Setter Target="gridHot.DesiredWidth" Value="560"/>
            <Setter Target="gridHot.ItemTemplate" Value="{StaticResource hotVideoCardWide}"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StackedCard">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0"/>
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="gridHot.ItemHeight" Value="278"/>
            <Setter Target="gridHot.DesiredWidth" Value="320"/>
            <Setter Target="gridHot.ItemTemplate" Value="{StaticResource hotVideoCardStacked}"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <controls:MyAdaptiveGridView x:Name="gridHot" ItemClick="gridHot_ItemClick" OneRowModeEnabled="False" Padding="8" StretchContentForSingleRow="False" ItemsSource="{x:Bind Path=hotVM.HotItems,Mode=OneWay}" ItemHeight="106" DesiredWidth="560" ItemTemplate="{StaticResource hotVideoCardWide}" LoadMoreBottomOffset="0" LoadMoreCommand="{x:Bind Path=hotVM.LoadMoreCommand}" CanLoadMore="True" Loading="{x:Bind Path=hotVM.Loading,Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True">
      <toolkit:AdaptiveGridView.ItemContainerStyle>
        <Style TargetType="GridViewItem">
          <Setter Property="Margin" Value="4"/>
        </Style>
      </toolkit:AdaptiveGridView.ItemContainerStyle>
      <controls:MyAdaptiveGridView.Header>
        <GridView ItemClick="gridTop_ItemClick" ItemsSource="{x:Bind Path=hotVM.TopItems,Mode=OneWay}" IsItemClickEnabled="True" SelectionMode="None" HorizontalAlignment="Center">
          <GridView.ItemTemplate>
            <DataTemplate x:DataType="modules:HotTopItemModel">
              <StackPanel>
                <Image Width="48" Margin="0 8" Height="48" Source="{x:Bind icon}"/>
                <TextBlock Margin="0 0 0 8" TextAlignment="Center" Text="{x:Bind title}"/>
              </StackPanel>
            </DataTemplate>
          </GridView.ItemTemplate>
          <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
              <Setter Property="Width" Value="100"/>
            </Style>
          </GridView.ItemContainerStyle>
        </GridView>
      </controls:MyAdaptiveGridView.Header>
      <controls:MyAdaptiveGridView.Footer>
        <Grid>
          <HyperlinkButton Command="{x:Bind Path=hotVM.LoadMoreCommand}" Visibility="{x:Bind Path=hotVM.Loading,Mode=OneWay,Converter={StaticResource display}}" Foreground="Gray" HorizontalAlignment="Center" x:Name="btnLoadMore">
            <TextBlock>加载更多</TextBlock>
          </HyperlinkButton>
          <ProgressRing IsActive="True" HorizontalAlignment="Center" Visibility="{x:Bind Path=hotVM.Loading,Mode=OneWay}"/>
        </Grid>
      </controls:MyAdaptiveGridView.Footer>
    </controls:MyAdaptiveGridView>
    <controls:RoundButton Command="{x:Bind Path=hotVM.RefreshCommand}" Visibility="{x:Bind Path=hotVM.Loading,Mode=OneWay,Converter={StaticResource display}}" VerticalAlignment="Bottom" Padding="12" Margin="12" HorizontalAlignment="Right">
      <SymbolIcon Symbol="Refresh" Foreground="White"/>
    </controls:RoundButton>
  </Grid>
</Page>
